{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "workflow-blueprint.schema.json",
    "title": "Workflow Blueprint",
    "description": "Declarative multi-agent workflow blueprint executed by the WorkflowConductor. Nodes reference agents by catalog id (core:<mode> or workspace:<wsId>:<assetId>), so default and custom Studio agents are interchangeable. The graph must be a DAG (acyclic); parallelism is implicit (independent ready nodes run concurrently up to config.maxParallel).",
    "type": "object",
    "required": [
        "id",
        "name",
        "nodes",
        "edges"
    ],
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string"
        },
        "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "description": "Unique blueprint identifier."
        },
        "name": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable blueprint name."
        },
        "version": {
            "type": "string",
            "description": "Optional blueprint version (free-form)."
        },
        "description": {
            "type": "string"
        },
        "config": {
            "type": "object",
            "additionalProperties": false,
            "description": "Run-level execution configuration.",
            "properties": {
                "mode": {
                    "type": "string",
                    "enum": [
                        "interactive",
                        "headless"
                    ],
                    "default": "interactive",
                    "description": "interactive = approvals/HITL prompt the chat user; headless = approvals resolved by policy (auto/fail-closed)."
                },
                "maxParallel": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16,
                    "default": 4,
                    "description": "Maximum number of nodes executed concurrently."
                },
                "onErrorDefault": {
                    "type": "string",
                    "enum": [
                        "abort",
                        "continue",
                        "retry"
                    ],
                    "default": "abort",
                    "description": "Default behavior when a node errors and the node has no explicit onError."
                },
                "budget": {
                    "type": "object",
                    "additionalProperties": false,
                    "description": "Hard caps that abort the run when exceeded (defense against runaway cost/loops).",
                    "properties": {
                        "maxNodes": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 50
                        },
                        "maxDurationMs": {
                            "type": "integer",
                            "minimum": 1000,
                            "default": 1800000
                        },
                        "maxTokens": {
                            "type": "integer",
                            "minimum": 0,
                            "default": 0,
                            "description": "0 = no token cap (best-effort accounting; tokens are estimated when the SDK does not report usage)."
                        }
                    }
                }
            }
        },
        "nodes": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/definitions/node"
            }
        },
        "edges": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/edge"
            }
        },
        "metadata": {
            "type": "object",
            "description": "Free-form metadata (author, createdAt, tags, ...).",
            "additionalProperties": true
        }
    },
    "definitions": {
        "node": {
            "type": "object",
            "required": [
                "id",
                "type"
            ],
            "additionalProperties": true,
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "start",
                        "end",
                        "agent",
                        "condition",
                        "approval",
                        "tool"
                    ]
                },
                "label": {
                    "type": "string"
                },
                "agent": {
                    "type": "string",
                    "description": "For type=agent: catalog id (core:<mode> or workspace:<wsId>:<assetId>)."
                },
                "input": {
                    "type": "string",
                    "description": "For type=agent: instruction template. Supports {{steps.<id>.output}} and {{run.input}} interpolation."
                },
                "expression": {
                    "type": "string",
                    "description": "For type=condition: a safe boolean expression evaluated against the run context (no code execution)."
                },
                "prompt": {
                    "type": "string",
                    "description": "For type=approval: message shown to the human (interactive) before downstream nodes run."
                },
                "tool": {
                    "type": "string",
                    "description": "For type=tool: tool name to invoke via the provided tool executor."
                },
                "params": {
                    "type": "object",
                    "description": "For type=tool: parameters for the tool invocation.",
                    "additionalProperties": true
                },
                "config": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "timeoutMs": {
                            "type": "integer",
                            "minimum": 1000
                        },
                        "onError": {
                            "type": "string",
                            "enum": [
                                "abort",
                                "continue",
                                "retry"
                            ]
                        },
                        "retry": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "maxAttempts": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 5,
                                    "default": 1
                                },
                                "backoffMs": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "default": 0
                                }
                            }
                        }
                    }
                }
            }
        },
        "edge": {
            "type": "object",
            "required": [
                "from",
                "to"
            ],
            "additionalProperties": false,
            "properties": {
                "from": {
                    "type": "string"
                },
                "to": {
                    "type": "string"
                },
                "when": {
                    "type": "string",
                    "description": "Optional safe boolean expression. The edge is traversable only when it evaluates truthy. Enables conditional branching."
                },
                "dataMapping": {
                    "type": "object",
                    "description": "Optional map of downstream-input-key -> source path (e.g., {\"ticketId\": \"steps.n1.output.ticketId\"}).",
                    "additionalProperties": {
                        "type": "string"
                    }
                }
            }
        }
    }
}
