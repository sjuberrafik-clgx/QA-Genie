{
  "name": "agentic-automation-workflow",
  "version": "1.0.0",
  "description": "Agentic workflow system for Playwright test automation with Jira integration",
  "main": "index.js",
  "scripts": {
    "setup": "node scripts/setup-project.js",
    "postinstall": "npx patch-package && cd mcp-server && npm install",
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "test:ui": "npx playwright test --ui",
    "report": "npx playwright show-report",
    "format-testcases": "node scripts/format-test-cases.js",
    "validate-excel": "node scripts/validate-test-case-excel.js",
    "mcp:unified": "node mcp-server/server.js",
    "mcp:unified:test": "node mcp-server/test-server.js",
    "workflow": "node orchestrator/workflow-orchestrator.js",
    "workflow:headed": "node orchestrator/workflow-orchestrator.js --headed",
    "sdk:pipeline": "node sdk-orchestrator/cli.js",
    "sdk:heal": "node sdk-orchestrator/cli.js --mode heal",
    "sdk:execute": "node sdk-orchestrator/cli.js --mode execute",
    "sdk:server": "node sdk-orchestrator/cli.js --server",
    "sdk:server:dev": "node sdk-orchestrator/cli.js --server --verbose",
    "notify:oh-mobile:preview": "node scripts/notify-oh-mobile-readiness.js --dry-run",
    "notify:oh-mobile:send": "node scripts/notify-oh-mobile-readiness.js --notify-current",
    "notify:release:preview": "node scripts/notify-oh-mobile-readiness.js --release --dry-run",
    "notify:release:send": "node scripts/notify-oh-mobile-readiness.js --release --notify-current",
    "repo-mesh": "node scripts/repo-mesh-setup.js",
    "repo-mesh:clone": "node scripts/repo-mesh-setup.js clone",
    "repo-mesh:sync": "node scripts/repo-mesh-setup.js sync",
    "repo-mesh:stats": "node scripts/repo-mesh-setup.js stats",
    "repo-mesh:test": "node repo-mesh/test-all.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@playwright/mcp": "^0.0.56",
    "@playwright/test": "^1.58.2",
    "@types/node": "^20.0.0",
    "allure-commandline": "^2.34.0",
    "allure-playwright": "^2.10.0",
    "chai": "^4.3.0",
    "cross-env": "^7.0.3",
    "mocha": "^10.0.0",
    "patch-package": "^8.0.1",
    "rimraf": "^6.1.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@github/copilot-sdk": "^0.1.32",
    "adm-zip": "^0.5.16",
    "axios": "^1.9.0",
    "docx": "^9.6.0",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "lodash": "^4.17.21",
    "mammoth": "^1.11.0",
    "node-pty": "^1.1.0",
    "ortoni-report": "^4.0.8",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "pptxgenjs": "^4.0.1",
    "ws": "^8.20.1",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "sharp": "^0.33.5"
  },
  "overrides": {
    "tar": "^7.5.15",
    "uuid": "^11.1.1",
    "serialize-javascript": "^7.0.5",
    "@tootallnate/once": "^2.0.1"
  }
}