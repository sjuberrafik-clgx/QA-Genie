{
	"inputs": [],
	"servers": {
		"glass": {
			"type": "stdio",
			"command": "node",
			"args": [
				"${workspaceFolder}/glass-mcp/src/server.js"
			],
			"env": {
				"GLASS_DRIVER": "cdp",
				"GLASS_HEADLESS": "false"
			}
		},
		"jira": {
			"type": "stdio",
			"command": "node",
			"args": [
				"${workspaceFolder}/agentic-workflow/mcp-server/jira-server.js"
			]
		},
		"atlassian/atlassian-mcp-server": {
			"type": "http",
			"url": "https://mcp.atlassian.com/v1/sse",
			"gallery": "https://api.mcp.github.com/",
			"version": "1.0.0"
		}
	}
}