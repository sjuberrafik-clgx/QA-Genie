# ═══════════════════════════════════════════════════════════════════════════════
# Root .gitignore — QA Dashboard + Agentic Workflow
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ─── Environment / Secrets ────────────────────────────────────────────────────
.env
.env.local
.env.*.local
# Private keys & certificates (any folder)
*.pem
*.key
*.pfx
*.p12
*.crt
# Common secret-bearing artifacts
secrets.json
secrets.yaml
secrets.yml
credentials.json
*-secrets.json
studio-workspaces/**/secrets*

# ─── Test Output ──────────────────────────────────────────────────────────────
test-results/
playwright-report/
my-report/
allure-results/
*.mp4
*.webm

# ─── Build Artifacts ─────────────────────────────────────────────────────────
.next/
.next-dev/
out/
dist/
build/

# ─── IDE / OS ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
*.code-workspace

# ─── Agentic Workflow Runtime ─────────────────────────────────────────────────
agentic-workflow/test-results/
agentic-workflow/test-artifacts/
agentic-workflow/learning-data/
agentic-workflow/studio-runtime/

# ─── Testing Artifacts (generated, not project code) ─────────────────────────
# Test case Excel files
agentic-workflow/test-cases/
# MCP exploration snapshots
agentic-workflow/exploration-data/
# Auto-generated grounding index files
agentic-workflow/grounding-data/
# Generated test scripts
tests/specs/
# Temp Excel lock files
~$*.xlsx

# ─── Playwright Cache ────────────────────────────────────────────────────────
blob-report/
