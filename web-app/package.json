{
  "name": "qa-automation-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean:dev": "node ./scripts/clean-next-dev-cache.js",
    "dev": "node ./scripts/start-next-dev.js",
    "verify:nav-routes": "node ./scripts/verify-nav-routes.js",
    "prebuild": "npm run verify:nav-routes",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "next lint",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:backend\"",
    "dev:backend": "node ../agentic-workflow/sdk-orchestrator/cli.js --server --port 3100 --verbose"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.2",
    "mermaid": "^11.12.3",
    "next": "^15.5.18",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^16.1.1",
    "react-virtuoso": "^4.18.7",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint-config-next": "^15.5.12",
    "playwright": "^1.59.1",
    "postcss": "^8.5.15",
    "pptxgenjs": "^4.0.1",
    "tailwindcss": "^3.4.16"
  },
  "overrides": {
    "postcss": "^8.5.15"
  }
}
